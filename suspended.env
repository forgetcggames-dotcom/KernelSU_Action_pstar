# Kernel Source and config naming.
KERNEL_SOURCE=https://github.com/MotorolaMobilityLLC/kernel-msm
KERNEL_SOURCE_BRANCH=android-13-release-t1ras33.55-15-10-6
KERNEL_CONFIG=vendor/pstar_stock_ksun_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS:LOCALVERSION=-ksun-susfs

# KernelSU flags
ENABLE_KERNELSU=true
KERNELSU_TAG=next-susfs
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
SUSFS_VERSION=1.5.12
Kernel_Version=4.19
Kernel_Extra_Version=4.19.157

